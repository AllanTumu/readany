{
  "name": "readany",
  "version": "0.2.0",
  "description": "Route and read documents into clean Markdown — Word, Excel, PowerPoint, OpenDocument, RTF, EPUB, CSV and text-layer PDF. Names the pages it could not read instead of dropping them silently. Text recognition is not included: it needs a native runtime.",
  "license": "MIT",
  "author": "Allan Tumuhimbise",
  "homepage": "https://github.com/AllanTumu/readany#readme",
  "repository": { "type": "git", "url": "git+https://github.com/AllanTumu/readany.git" },
  "bugs": { "url": "https://github.com/AllanTumu/readany/issues" },
  "keywords": ["markdown","document","pdf","docx","xlsx","pptx","epub","rtf","ocr","wasm","converter","extract","parse"],
  "main": "readany_wasm.js",
  "types": "readany_wasm.d.ts",
  "exports": {
    ".": { "types": "./readany_wasm.d.ts", "default": "./readany_wasm.js" },
    "./web": { "types": "./readany_wasm_web.d.ts", "default": "./readany_wasm_web.js" },
    "./readany_wasm_bg.wasm": "./readany_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": ["readany_wasm.js","readany_wasm.d.ts","readany_wasm_web.js","readany_wasm_web.d.ts","readany_wasm_bg.wasm","readany_wasm_bg.wasm.d.ts","README.md","LICENSE","THIRD-PARTY-LICENSES.md"],
  "engines": { "node": ">=18" },
  "sideEffects": ["./readany_wasm.js"],
  "publishConfig": { "access": "public" }
}
